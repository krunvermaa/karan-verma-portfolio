# .env.example — names and placeholders ONLY. Safe to commit.
# Real values go in .env.local (git-ignored) and in the host dashboard. Never commit real values.
#
# RULE: Vite inlines every VITE_* variable into the public JS bundle.
#       Only put values here that are SAFE FOR EVERYONE TO SEE, and mark them "# PUBLIC".
#       Secrets (API keys, tokens, passwords) must NEVER start with VITE_ and must only be
#       read by server-side functions on the host.

# --- PUBLIC (shipped to the browser) ---
# VITE_SITE_URL=https://example.com            # PUBLIC
# VITE_CONTACT_EMAIL=you@example.com           # PUBLIC (only if Karan wants it published)

# --- SERVER-ONLY (set in host dashboard; read only by serverless functions) ---
# CONTACT_FORM_API_KEY=__set_in_host_dashboard__
# EMAIL_SERVICE_TOKEN=__set_in_host_dashboard__
# ALLOWED_ORIGIN=https://example.com
