      "text": "ARCHITECTURAL SOLUTION",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "ARCHITECTURAL SOLUTION",
      "lineHeight": 1.25
    },
    {
      "id": "txt_492_ikwgc0",
      "type": "text",
      "x": 2353,
      "y": 562,
      "width": 348,
      "height": 63,
      "angle": 0,
      "strokeColor": "#14532d",
      "backgroundColor": "transparent",
      "fillStyle": "transparent",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 34567,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792304434693,
      "link": null,
      "locked": false,
      "text": "Engineered high-throughput event pipeline:\n• WebSocket duplex channels replacing HTTP polling\n• Redis Geo-Spatial indexing for O(log N) proximity search\n• Partitioned PostgreSQL event logs with spatial indexes\n• Sub-100ms client UI updates with React 19 concurrent state",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "Engineered high-throughput event pipeline:\n• WebSocket duplex channels replacing HTTP polling\n• Redis Geo-Spatial indexing for O(log N) proximity search\n• Partitioned PostgreSQL event logs with spatial indexes\n• Sub-100ms client UI updates with React 19 concurrent state",
      "lineHeight": 1.25
    },
