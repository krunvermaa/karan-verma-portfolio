      "lineHeight": 1.25
    },
    {
      "id": "txt_603_1b6tae",
      "type": "text",
      "x": 1948,
      "y": 562,
      "width": 348,
      "height": 63,
      "angle": 0,
      "strokeColor": "#7f1d1d",
      "backgroundColor": "transparent",
      "fillStyle": "transparent",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 82094,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792297368186,
      "link": null,
      "locked": false,
      "text": "Legacy vehicle dispatch suffered from:\n• Polling bottlenecks creating 3-5s stale locations\n• Database lock contention under 10k+ concurrent drivers\n• Inaccurate ETA calculations ignoring real-time bottlenecks\n• Lack of end-to-end telemetry traceability",
      "fontSize": 10,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 8,
      "containerId": null,
      "originalText": "Legacy vehicle dispatch suffered from:\n• Polling bottlenecks creating 3-5s stale locations\n• Database lock contention under 10k+ concurrent drivers\n• Inaccurate ETA calculations ignoring real-time bottlenecks\n• Lack of end-to-end telemetry traceability",
      "lineHeight": 1.25
    },
